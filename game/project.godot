; Daybloom — projeto Godot 4
config_version=5

[application]

config/name="Daybloom"
config/description="Simulação de vida aconchegante com moradores autônomos."
config/version="0.3.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.99, 0.95, 0.88, 1)

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
GameClock="*res://scripts/autoload/game_clock.gd"
ApiClient="*res://scripts/autoload/api_client.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
Settings="*res://scripts/autoload/settings.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="mundo"
3d_physics/layer_2="jogadora"
3d_physics/layer_3="moradores"

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.62, 0.84, 0.95, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
